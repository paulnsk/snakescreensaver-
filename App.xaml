<Application x:Class="SnakeScreensaver.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SnakeScreensaver"
             Startup="App_OnStartup"
             Exit="App_OnExit">
    <Application.Resources>

        <FontFamily x:Key="HeavyFont">Bahnschrift SemiBold Condensed, Bahnschrift, Segoe UI Black</FontFamily>
        <FontFamily x:Key="BodyFont">Bahnschrift SemiBold, Bahnschrift, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="InkBrush" Color="#FF0B0B0D"/>
        <SolidColorBrush x:Key="SteelBrush" Color="#FF262930"/>
        <SolidColorBrush x:Key="SteelHotBrush" Color="#FF30343C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFA9ADB6"/>
        <SolidColorBrush x:Key="AcidBrush" Color="#FFB6FF3B"/>
        <SolidColorBrush x:Key="FlameBrush" Color="#FFFF6A1A"/>
        <SolidColorBrush x:Key="BloodBrush" Color="#FFFF3B3B"/>
        <SolidColorBrush x:Key="ToxicBrush" Color="#FF2EE6D6"/>
        <SolidColorBrush x:Key="HazardBrush" Color="#FFFFD60A"/>

        <DrawingBrush x:Key="Grit" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF16171B" Geometry="M0,0 H14 V14 H0 Z"/>
                    <GeometryDrawing Brush="#FF1C1E23" Geometry="M0,14 L14,0 L14,3 L3,14 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="HazardStripes" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFD60A" Geometry="M0,0 H22 V22 H0 Z"/>
                    <GeometryDrawing Brush="#FF0B0B0D" Geometry="M0,22 L11,0 L22,0 L11,22 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DropShadowEffect x:Key="HardShadow" Color="Black" Direction="315" ShadowDepth="5" BlurRadius="0" Opacity="1"/>
        <DropShadowEffect x:Key="HardShadowSmall" Color="Black" Direction="315" ShadowDepth="3" BlurRadius="0" Opacity="1"/>
        <DropShadowEffect x:Key="WindowShadow" Color="Black" Direction="315" ShadowDepth="8" BlurRadius="14" Opacity="0.7"/>

        <Style x:Key="BrutalTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeavyFont}"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource AcidBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect" Value="{StaticResource HardShadowSmall}"/>
        </Style>

        <Style x:Key="TrayChip" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TrayChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TrayBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SteelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource HeavyFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="10,8,18,8"/>
            <Setter Property="Margin" Value="0,6,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource HardShadow}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="3" Y="3"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Body" Property="Effect" Value="{StaticResource HardShadowSmall}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SteelHotBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AcidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrayBtnQuit" TargetType="Button" BasedOn="{StaticResource TrayBtn}">
            <Setter Property="Foreground" Value="{StaticResource BloodBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BloodBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrayBtnText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeavyFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TrayExpander" TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource SteelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="16,12,12,12"/>
            <Setter Property="Margin" Value="0,6,6,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Effect="{StaticResource HardShadow}">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              FocusVisualStyle="{x:Null}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Cursor="Hand"
                                              Padding="{TemplateBinding Padding}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                                <Border x:Name="ArrowChip" Grid.Column="1" Width="28" Height="28" CornerRadius="4"
                                                        Background="{StaticResource InkBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Arrow" Text="▶" FontSize="13"
                                                               Foreground="{StaticResource AcidBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderTransformOrigin="0.5,0.5"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="ArrowChip" Property="Background" Value="{StaticResource AcidBrush}"/>
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource InkBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                               FontFamily="{StaticResource HeavyFont}"
                                               FontSize="20"
                                               Foreground="{StaticResource TextBrush}"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Margin="0,0,0,10"
                                                  Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AcidBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill"
                                CornerRadius="4"
                                Margin="4,0"
                                Background="#FF1B1D22"
                                BorderBrush="#FF3E424B"
                                BorderThickness="2"
                                Padding="10,6,14,6">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="Dot" Width="12" Height="12" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" Fill="Transparent" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AcidBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AcidBrush}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource InkBrush}"/>
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource InkBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource InkBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SteelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6,6,12,12"/>
            <Setter Property="Effect" Value="{StaticResource HardShadow}"/>
        </Style>

        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeavyFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource AcidBrush}"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>

        <Style x:Key="SettingsCheckbox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="Track" Grid.Column="1" Width="56" Height="28" CornerRadius="4"
                                    Background="#FF1B1D22" BorderBrush="{StaticResource InkBrush}" BorderThickness="2.5"
                                    VerticalAlignment="Center">
                                <Border x:Name="Knob" Width="20" Height="18" CornerRadius="2" Background="{StaticResource MutedBrush}"
                                        HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource FlameBrush}"/>
                                <Setter TargetName="Knob" Property="Background" Value="{StaticResource InkBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AcidBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,4,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="14" CornerRadius="3" Background="#FF1B1D22" BorderBrush="{StaticResource InkBrush}" BorderThickness="2"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="14" CornerRadius="3" Background="{StaticResource HazardStripes}"
                                                        BorderBrush="{StaticResource InkBrush}" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="22" Height="30" CornerRadius="3" Background="{StaticResource AcidBrush}"
                                                        BorderBrush="{StaticResource InkBrush}" BorderThickness="3"
                                                        Effect="{StaticResource HardShadowSmall}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsOkBtn" TargetType="Button" BasedOn="{StaticResource TrayBtn}">
            <Setter Property="Background" Value="{StaticResource AcidBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="34,8"/>
            <Setter Property="MinWidth" Value="180"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFCBFF6E"/>
                    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsCancelBtn" TargetType="Button" BasedOn="{StaticResource TrayBtn}">
            <Setter Property="Foreground" Value="{StaticResource BloodBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="34,8"/>
            <Setter Property="MinWidth" Value="180"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BloodBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
