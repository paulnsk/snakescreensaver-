<Window x:Class="SnakeScreensaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake Settings"
        Width="560" Height="980"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="28" Padding="22">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C0F8F" Offset="0"/>
                <GradientStop Color="#FF1AABAE" Offset="0.4"/>
                <GradientStop Color="#FFF15E48" Offset="0.8"/>
                <GradientStop Color="#FFFFB400" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#FF66CC" BlurRadius="46" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="22" Padding="18,8" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFD9F0" Offset="0"/>
                        <GradientStop Color="#FF4F08DE" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#FFFF66FF" BlurRadius="18" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="⚙️ SNAKE SETTINGS 🐍" FontSize="30" FontWeight="Black"
                           Foreground="White" FontFamily="Comic Sans MS, Segoe UI"/>
            </Border>

            <Border Grid.Row="1" CornerRadius="22" Padding="22" Background="#CC110022" Margin="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">

                        <TextBlock Text="🖥️ RENDERER" Style="{StaticResource SettingsLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <RadioButton x:Name="RendererWpf" Content="WPF (legacy)" GroupName="rnd" Style="{StaticResource TrayRadio}" Checked="Renderer_Checked"/>
                            <RadioButton x:Name="RendererSkia" Content="Skia" GroupName="rnd" Style="{StaticResource TrayRadio}" Checked="Renderer_Checked" Margin="14,0,0,0"/>
                            <RadioButton x:Name="RendererWpfTurbo" Content="WPF TURBO" GroupName="rnd" Style="{StaticResource TrayRadio}" Checked="Renderer_Checked" Margin="14,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="🎮 RENDER MODE" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <RadioButton x:Name="RenderBalls" Content="⚽ Balls" GroupName="rm" Style="{StaticResource TrayRadio}" Checked="Render_Checked"/>
                            <RadioButton x:Name="RenderRibbon" Content="🌀 Ribbon" GroupName="rm" Style="{StaticResource TrayRadio}" Checked="Render_Checked" Margin="14,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="🚪 EXIT WHEN" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <RadioButton x:Name="ExitEsc" Content="ESC key only" GroupName="em" Style="{StaticResource TrayRadio}" Checked="Exit_Checked"/>
                            <RadioButton x:Name="ExitMouse" Content="Mouse moves" GroupName="em" Style="{StaticResource TrayRadio}" Checked="Exit_Checked" Margin="14,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="🌈 ANIMATED RAINBOW" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <CheckBox x:Name="RainbowChk" Content="per-frame color cycling" Style="{StaticResource SettingsCheckbox}" Checked="Rainbow_Changed" Unchecked="Rainbow_Changed"/>

                        <TextBlock Text="🌑 DROP SHADOW" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <CheckBox x:Name="DropShadowChk" Content="glow shadow under snake (perf hit; disable for slow GPU)" Style="{StaticResource SettingsCheckbox}" Checked="DropShadow_Changed" Unchecked="DropShadow_Changed"/>

                        <TextBlock Text="😋 HUNGRY SNAKE" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <CheckBox x:Name="LivingSnakeChk" Content="animated mouth, bites &amp; digestion" Style="{StaticResource SettingsCheckbox}"
                                  IsEnabled="{Binding IsChecked, ElementName=RendererWpfTurbo}"
                                  Checked="LivingSnake_Changed" Unchecked="LivingSnake_Changed"/>

                        <TextBlock Text="✨ MAGIC POOP" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <CheckBox x:Name="MagicPoopChk" Content="sparkling rainbow treats from the tail" Style="{StaticResource SettingsCheckbox}"
                                  IsEnabled="{Binding IsChecked, ElementName=RendererWpfTurbo}"
                                  Checked="MagicPoop_Changed" Unchecked="MagicPoop_Changed"/>

                        <TextBlock Text="⏰ IDLE LAUNCH (minutes)" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <Slider x:Name="IdleSlider" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                Style="{StaticResource SettingsSlider}" AutoToolTipPlacement="TopLeft"
                                AutoToolTipPrecision="0" ValueChanged="Idle_Changed"/>

                        <TextBlock Text="🪛 RUN ON SYSTEM STARTUP" Style="{StaticResource SettingsLabel}" Margin="0,14,0,0"/>
                        <CheckBox x:Name="StartupChk" Content="launch snake-in-tray on user logon" Style="{StaticResource SettingsCheckbox}" Checked="Startup_Changed" Unchecked="Startup_Changed"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="APPLY 💾" Style="{StaticResource SettingsOkBtn}" Click="OK_Click"/>
                <Button Content="CANCEL 🙈" Style="{StaticResource SettingsCancelBtn}" Click="Cancel_Click" Margin="14,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
