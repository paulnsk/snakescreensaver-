<Window x:Class="SnakeScreensaver.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnakeMenu"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated">
    <Border x:Name="Root"
            CornerRadius="8"
            Margin="16"
            Background="{StaticResource Grit}"
            BorderBrush="{StaticResource InkBrush}"
            BorderThickness="3"
            Effect="{StaticResource WindowShadow}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.9" ScaleY="0.9"/>
        </Border.RenderTransform>
        <StackPanel Orientation="Vertical">
            <Border Height="12" CornerRadius="5,5,0,0" Background="{StaticResource HazardStripes}"/>
            <StackPanel Orientation="Vertical" Margin="16,12,10,14" Width="340">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Border Style="{StaticResource TrayChip}" Background="{StaticResource AcidBrush}" Width="44" Height="44">
                        <TextBlock Text="🐍" Style="{StaticResource TrayChipText}" FontSize="22"/>
                    </Border>
                    <TextBlock Text="SNAKE SNAKE" Style="{StaticResource BrutalTitle}"/>
                </StackPanel>

                <Button x:Name="LaunchBtn" Style="{StaticResource TrayBtn}" Click="Launch_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TrayChip}" Background="{StaticResource AcidBrush}">
                            <TextBlock Text="🚀" Style="{StaticResource TrayChipText}"/>
                        </Border>
                        <TextBlock Text="LAUNCH SNAKE NOW" Style="{StaticResource TrayBtnText}"/>
                    </StackPanel>
                </Button>

                <Expander x:Name="RenderExp" Header="🎨  RENDER MODE" Style="{StaticResource TrayExpander}">
                    <WrapPanel Margin="10,0">
                        <RadioButton x:Name="RenderBalls" Content="⚽ Balls" GroupName="rm"
                                     Style="{StaticResource TrayRadio}" Checked="Render_Checked"/>
                        <RadioButton x:Name="RenderRibbon" Content="🌀 Ribbon" GroupName="rm"
                                     Style="{StaticResource TrayRadio}" Checked="Render_Checked"/>
                    </WrapPanel>
                </Expander>

                <Expander x:Name="ExitExp" Header="🚪  EXIT MODE" Style="{StaticResource TrayExpander}">
                    <WrapPanel Margin="10,0">
                        <RadioButton x:Name="ExitEsc" Content="Esc key only" GroupName="em"
                                     Style="{StaticResource TrayRadio}" Checked="Exit_Checked"/>
                        <RadioButton x:Name="ExitMouse" Content="Any mouse move" GroupName="em"
                                     Style="{StaticResource TrayRadio}" Checked="Exit_Checked"/>
                    </WrapPanel>
                </Expander>

                <Expander x:Name="IdleExp" Header="⏰  IDLE LAUNCH" Style="{StaticResource TrayExpander}">
                    <WrapPanel x:Name="IdlePanel" Margin="10,0"/>
                </Expander>

                <Button x:Name="RainbowBtn" Style="{StaticResource TrayBtn}" Click="Rainbow_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TrayChip}" Background="{StaticResource ToxicBrush}">
                            <TextBlock x:Name="RainbowChk" Text="🌈" Style="{StaticResource TrayChipText}"/>
                        </Border>
                        <TextBlock x:Name="RainbowLabel" Text="RAINBOW: ON" Style="{StaticResource TrayBtnText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SettingsBtn" Style="{StaticResource TrayBtn}" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TrayChip}" Background="{StaticResource HazardBrush}">
                            <TextBlock Text="⚙" Style="{StaticResource TrayChipText}"/>
                        </Border>
                        <TextBlock Text="SETTINGS..." Style="{StaticResource TrayBtnText}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuitBtn" Style="{StaticResource TrayBtnQuit}" Click="Quit_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TrayChip}" Background="{StaticResource BloodBrush}">
                            <TextBlock Text="💀" Style="{StaticResource TrayChipText}"/>
                        </Border>
                        <TextBlock Text="QUIT SNAKE" Style="{StaticResource TrayBtnText}"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
