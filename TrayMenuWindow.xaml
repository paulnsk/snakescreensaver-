<Window x:Class="SnakeScreensaver.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnakeMenu"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated">
    <Border x:Name="Root"
            CornerRadius="26"
            Padding="18"
            RenderTransformOrigin="0.5,0.5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3D1AB7" Offset="0"/>
                <GradientStop Color="#FF0F7EAE" Offset="0.4"/>
                <GradientStop Color="#FF3EA85B" Offset="0.7"/>
                <GradientStop Color="#FFD9A12F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#FF6BC4" BlurRadius="28" ShadowDepth="0" Opacity="0.85"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.9" ScaleY="0.9"/>
        </Border.RenderTransform>
        <StackPanel Orientation="Vertical">

            <Border CornerRadius="18" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFF66CC" Offset="0"/>
                        <GradientStop Color="#FF5D0F8F" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#FF66FF" BlurRadius="16" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="🐍 SNAKE SNAKE! 🐍" FontSize="26" FontWeight="Black"
                           Foreground="White" FontFamily="Comic Sans MS, Segoe UI"/>
            </Border>

            <Button x:Name="LaunchBtn" Style="{StaticResource TrayBtn}" Click="Launch_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚀" FontSize="26" Margin="0,0,12,0"/>
                    <TextBlock Text="LAUNCH SNAKE NOW" Style="{StaticResource TrayBtnText}"/>
                </StackPanel>
            </Button>

            <Expander  x:Name="RenderExp" Header="RENDER MODE  🎨" Style="{StaticResource TrayExpander}">
                <StackPanel Margin="14,4">
                    <RadioButton x:Name="RenderBalls" Content="⚽ Balls (segmented)" GroupName="rm"
                                 Style="{StaticResource TrayRadio}" Checked="Render_Checked"/>
                    <RadioButton x:Name="RenderRibbon" Content="🌀 Ribbon (continuous)" GroupName="rm"
                                 Style="{StaticResource TrayRadio}" Checked="Render_Checked"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="ExitExp" Header="EXIT MODE  🚪" Style="{StaticResource TrayExpander}">
                <StackPanel Margin="14,4">
                    <RadioButton x:Name="ExitEsc" Content="Escape key only" GroupName="em"
                                 Style="{StaticResource TrayRadio}" Checked="Exit_Checked"/>
                    <RadioButton x:Name="ExitMouse" Content="Any mouse move" GroupName="em"
                                 Style="{StaticResource TrayRadio}" Checked="Exit_Checked"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="IdleExp" Header="IDLE LAUNCH  ⏰" Style="{StaticResource TrayExpander}">
                <StackPanel x:Name="IdlePanel" Margin="14,4"/>
            </Expander>

            <Button x:Name="RainbowBtn" Style="{StaticResource TrayBtn}" Click="Rainbow_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RainbowChk" Text="🌈" FontSize="26" Margin="0,0,6,0"/>
                    <TextBlock x:Name="RainbowLabel" Text="RAINBOW: ON" Style="{StaticResource TrayBtnText}"/>
                </StackPanel>
            </Button>

            <Button x:Name="SettingsBtn" Style="{StaticResource TrayBtn}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="26" Margin="0,0,12,0"/>
                    <TextBlock Text="SETTINGS..." Style="{StaticResource TrayBtnText}"/>
                </StackPanel>
            </Button>

            <Button x:Name="QuitBtn" Style="{StaticResource TrayBtnQuit}" Click="Quit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💀" FontSize="26" Margin="0,0,12,0"/>
                    <TextBlock Text="QUIT SNAKE" Style="{StaticResource TrayBtnText}"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</Window>
